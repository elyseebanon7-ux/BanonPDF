# BanonPDF Environment Variables Example
# DO NOT COMMIT REAL SECRET VALUES TO GIT.
# Copy this file to .env.local for local development.

# Application Configuration
VITE_APP_ENV=development
VITE_APP_NAME=BanonPDF

# Optional Cloud Sync & Backend (Supabase / Microservices)
# Client side only uses public ANON keys with Row Level Security (RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# AI & OCR Cloud Processing (Optional Fallbacks)
VITE_AI_PROVIDER_API_KEY=YOUR_AI_PROVIDER_KEY_HERE
VITE_OCR_FALLBACK_URL=https://ocr.example.com/api

# Security & Storage Configuration
VITE_ENABLE_OFFLINE_MODE=true
VITE_STORAGE_ENCRYPTION_ALGORITHM=AES-GCM-256
